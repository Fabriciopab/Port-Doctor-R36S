{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Port Doctor R36S compatibility pack",
  "type": "object",
  "required": ["format", "id", "license", "source", "files"],
  "properties": {
    "format": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "license": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "architecture", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^lib.+\\.so(?:\\.[0-9]+)*$" },
          "path": { "type": "string", "pattern": "^[^/].+$" },
          "architecture": { "enum": ["aarch64", "armhf", "x86_64"] },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
